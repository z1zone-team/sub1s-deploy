# ==============================================================================
# Sub1S Production Environment Variables (.env.example)
# ==============================================================================

# ── 도메인 & Nginx 설정 ───────────────────────────────────────────────────────
# OCI 인스턴스 공인 IP에 A 레코드로 연결된 서브도메인 (예: api.sub1s.com)
DOMAIN=api.sub1s.com
# 최초 SSL 발급 전에는 default.http-only.conf, 발급 후에는 default.conf
NGINX_CONF=default.conf

# ── PostgreSQL 16 (pgvector) ──────────────────────────────────────────────────
POSTGRES_PORT=5432
DB_PASSWORD=your_secure_db_password_here

# ── Valkey 7.2 (Redis 호환) ───────────────────────────────────────────────────
VALKEY_PORT=6379

# ── NestJS 코어 백엔드 ────────────────────────────────────────────────────────
# Clerk 인증 시크릿 키 (sk_test_... 또는 sk_live_...)
CLERK_SECRET_KEY=sk_live_sample_secret_key
# 모바일 앱 요청 유효성 검증용 X-Sub1S-Client-Key
CLIENT_KEY=your_production_client_key_here
# 3-Tier 하이브리드 암호화 마스터 키 (24바이트/24문자 문자열)
MASTER_3DES_KEY=sub1s-master-key-24bytes
MASTER_ENCRYPTION_KEY=sub1s-master-key-24bytes
# 라우팅 엔진 선택: DIJKSTRA (기본 권장) 또는 ASTAR
ROUTING_ENGINE=DIJKSTRA

# ── FastAPI AI 워커 ───────────────────────────────────────────────────────────
# Google Gemini API 키 (NLU 의도 분석 및 브리핑 생성용)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Docker 이미지 레지스트리 (GitHub Packages) ───────────────────────────────
SERVER_IMAGE=ghcr.io/z1zone-team/sub1s-server:latest
AI_IMAGE=ghcr.io/z1zone-team/sub1s-ai:latest
